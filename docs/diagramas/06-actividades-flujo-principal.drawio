<mxfile host="drawio" agent="Claude" version="24.0.0"><diagram id="p0" name="Actividades: flujo principal"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Diagrama de actividades: flujo principal de una solicitud&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Desde la publicación hasta la calificación (EP-004, EP-005 y EP-007)&lt;/span&gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Cliente" style="swimlane;startSize=34;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="1460" as="geometry"/></mxCell><mxCell id="c3" value="Sistema ¿Quién lo tiene?" style="swimlane;startSize=34;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="70" width="400" height="1460" as="geometry"/></mxCell><mxCell id="c4" value="Tienda" style="swimlane;startSize=34;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="400" height="1460" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="225.0" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Publicar solicitud (producto, cantidad, modalidad, ubicación)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130.0" y="165" width="220" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Validar y difundir a tiendas elegibles en 3 km" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530.0" y="245" width="220" height="50" as="geometry"/></mxCell><mxCell id="c8" value="Revisar la solicitud en el panel (sin datos del cliente)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930.0" y="325" width="220" height="50" as="geometry"/></mxCell><mxCell id="c9" value="¿Tiene el producto?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="915.0" y="400" width="130" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Responder&lt;br&gt;No lo tengo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1115.0" y="410" width="110" height="50" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1155.0" y="500" width="30" height="30" as="geometry"/></mxCell><mxCell id="c12" value="Responder Sí lo tengo o Tengo algo parecido (precio, cantidad, domicilio)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870.0" y="500" width="220" height="50" as="geometry"/></mxCell><mxCell id="c13" value="Notificar la respuesta al cliente (SSE o push)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530.0" y="590" width="220" height="50" as="geometry"/></mxCell><mxCell id="c14" value="Comparar respuestas por precio o cercanía" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130.0" y="670" width="220" height="50" as="geometry"/></mxCell><mxCell id="c15" value="¿Elige una respuesta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="175.0" y="750" width="130" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Vencer la solicitud a los 30 minutos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540.0" y="760" width="200" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625.0" y="850" width="30" height="30" as="geometry"/></mxCell><mxCell id="c18" value="Confirmar orden: modalidad, dirección y medio de pago" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130.0" y="860" width="220" height="50" as="geometry"/></mxCell><mxCell id="c19" value="Crear orden, calcular total y avisar a la tienda elegida" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530.0" y="940" width="220" height="50" as="geometry"/></mxCell><mxCell id="c20" value="Preparar el pedido" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930.0" y="1020" width="220" height="50" as="geometry"/></mxCell><mxCell id="c21" value="¿Modalidad?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975.0" y="1095" width="130" height="70" as="geometry"/></mxCell><mxCell id="c22" value="Enviar con su domiciliario" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><