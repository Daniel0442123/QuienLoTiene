<mxfile host="drawio" agent="Claude" version="24.0.0"><diagram id="p0" name="Secuencia CU-12: contactar por WhatsApp o mini chat"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="808" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Secuencia CU-12: contactar por WhatsApp o mini chat&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;HU-032 y HU-033&lt;/span&gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="l0" value="Cliente o tienda" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l1" value="PWA" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l2" value="WhatsApp" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l3" value="API REST&lt;br&gt;módulo mensajeria" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l4" value="módulo ordenes&lt;br&gt;(fachada api)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l6" value="Notificaciones&lt;br&gt;(SSE / push)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="l7" value="PWA de la&lt;br&gt;otra parte" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="70" width="150" height="636" as="geometry"/></mxCell><mxCell id="n0" value="Mini chat sin adjuntos y sin &quot;leído&quot;. Solo existe mientras la orden está activa (fachada api: orden activa). El historial se lee con GET /api/v1/ordenes/{id}/mensajes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="726" width="1400" height="52" as="geometry"/></mxCell><mxCell id="c9" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="124" width="1438" height="538" as="geometry"/></mxCell><mxCell id="c10" value="[WhatsApp]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="112" y="124" width="360" height="22" as="geometry"/></mxCell><mxCell id="m11" value="1. Toca &quot;Escribir por WhatsApp&quot;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="164" as="sourcePoint"/><mxPoint x="295" y="164" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="2. Armar enlace wa.me con teléfono y número de orden" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;spacingLeft=48;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="206" as="sourcePoint"/><mxPoint x="295" y="224" as="targetPoint"/><Array as="points"><mxPoint x="335" y="206"/><mxPoint x="335" y="224"/></Array></mxGeometry></mxCell><mxCell id="m13" value="3. Abrir enlace wa.me" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="248" as="sourcePoint"/><mxPoint x="475" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="268" as="sourcePoint"/><mxPoint x="1484" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="[mini chat]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="54" y="268" width="360" height="22" as="geometry"/></mxCell><mxCell id="m16" value="4. Escribe un mensaje de texto" style="html=1;