" y="486" as="sourcePoint"/><mxPoint x="295" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m18" value="10. Ficha: mapa, horario, abierta, pagos, reseñas" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="528" as="sourcePoint"/><mxPoint x="115" y="528" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>