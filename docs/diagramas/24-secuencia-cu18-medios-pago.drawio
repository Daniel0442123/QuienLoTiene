ometry"/></mxCell><mxCell id="m14" value="4. 400 Bad Request" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="290" as="sourcePoint"/><mxPoint x="295" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="5. &quot;Elige al menos un medio de pago&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="332" as="sourcePoint"/><mxPoint x="115" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="352" as="sourcePoint"/><mxPoint x="764" y="352" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="[válido]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="54" y="352" width="360" height="22" as="geometry"/></mxCell><mxCell id="m18" value="6. Guardar mediosPago" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="384" as="sourcePoint"/><mxPoint x="655" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m19" value="7. 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="426" as="sourcePoint"/><mxPoint x="295" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m20" value="8. &quot;Medios de pago actualizados&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="468" as="sourcePoint"/><mxPoint x