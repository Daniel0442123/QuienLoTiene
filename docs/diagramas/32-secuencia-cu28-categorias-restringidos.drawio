<mxfile host="drawio" agent="Claude" version="24.0.0"><diagram id="p0" name="Secuencia CU-28: gestionar categorías y productos restringidos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="766" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Secuencia CU-28: gestionar categorías y productos restringidos&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;HU-038 e incluye registrar auditoría (RNF-013)&lt;/span&gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="l0" value="Administrador" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="150" height="594" as="geometry"/></mxCell><mxCell id="l1" value="PWA administración" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="70" width="150" height="594" as="geometry"/></mxCell><mxCell id="l2" value="API REST&lt;br&gt;módulo catalogo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="150" height="594" as="geometry"/></mxCell><mxCell id="l3" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineCon