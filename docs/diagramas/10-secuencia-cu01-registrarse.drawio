<mxfile host="drawio" agent="Claude" version="24.0.0"><diagram id="p0" name="Secuencia CU-01: registrarse como cliente"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="892" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Secuencia CU-01: registrarse como cliente&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;HU-001 e incluye HU-005 (aceptar política de datos)&lt;/span&gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="l0" value="Cliente" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="150" height="720" as="geometry"/></mxCell><mxCell id="l1" value="PWA cliente" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="70" width="150" height="720" as="geometry"/></mxCell><mxCell id="l2" value="API REST&lt;br&gt;módulo identidad" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="150" height="720" as="geometry"/></mxCell><mxCell id="l3" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="150" height="720" as="geometry"/></mxCell><mxCell id="n0" value="Incluye «Aceptar política de datos» (HU-005): la PWA no envía el registro sin la casilla marcada y la API rechaza la petición si falta la versión de la política. AutorizacionDatos guarda la versión y la fecha de aceptación." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="700" height="52" as="geometry"/></mxCell><mxCell id="m9" value="1. Nombre, correo, teléfono y frase de contraseña" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="150" as="sourcePoint"/><mxPoint x="295" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="2. Mostrar política de tratamiento de datos (Ley 1581)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;spacingLeft=48;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="192" as="sourcePoint"/><mxPoint x="295" y="210" as="targetPoint"/><Array as="points"><mxPoint x="335" y="192"/><mxPoint x="335" y="210"/></Array></mxGeometry></mxCell><mxCell id="m11" value="3. Marca la casilla de autorización" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="234" as="sourcePoint"/><mxPoint x="295" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="4. POST /api/v1/auth/registro" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="276" as="sourcePoint"/><mxPoint x="475" y="276" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="5. Validar datos y frase de 15 o más caracteres" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;spacingLeft=48;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="318" as="sourcePoint"/><mxPoint x="475" y="336" as="targetPoint"/><Array as="points"><mxPoint x="515" y="318"/><mxPoint x="515" y="336"/></Array></mxGeometry></mxCell><mxCell id="m14" value="6. ¿Existe el correo?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="360" as="sourcePoint"/><mxPoint x="655" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="7. Resultado" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="402" as="sourcePoint"/><mxPoint x="475" y="402" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="418" width="718" height="328" as="geometry"/></mxCell><mxCell id="c17" value="[correo ya registrado]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="112" y="418" width="360" height="22" as="geometry"/></mxCell><mxCell id="m18" value="8. 409 Conflict" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="458" as="sourcePoint"/><mxPoint x="295" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m19" value="9. &quot;Ese correo ya tiene una cuenta&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="500" as="sourcePoint"/><mxPoint x="115" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="520" as="sourcePoint"/><mxPoint x="764" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="[datos válidos]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="54" y="520" width="360" height="22" as="geometry"/></mxCell><mxCell id="m22" value="10. Calcular hash de la frase" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;spacingLeft=48;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="552" as="sourcePoint"/><mxPoint x="475" y="570" as="targetPoint"/><Array as="points"><mxPoint x="515" y="552"/><mxPoint x="515" y="570"/></Array></mxGeometry></mxCell><mxCell id="m23" value="11. Guardar Usuario CLIENTE ACTIVA + AutorizacionDatos" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="594" as="sourcePoint"/><mxPoint x="655" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m24" value="12. OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="636" as="sourcePoint"/><mxPoint x="475" y="636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m25" value="13. 201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="678" as="sourcePoint"/><mxPoint x="295" y="678" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m26" value="14. &quot;Cuenta creada&quot;, ir a iniciar sesión" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="720" as="sourcePoint"/><mxPoint x="115" y="720" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>