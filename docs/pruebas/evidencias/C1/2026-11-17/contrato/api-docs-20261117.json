{"openapi":"3.1.0","info":{"title":"OpenAPI definition","version":"v0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Tiendas","description":"Registro y configuración de las tiendas"},{"name":"Órdenes","description":"Crear la orden, avanzar su estado y confirmar recepción"},{"name":"Solicitudes","description":"Publicar, ver y responder solicitudes"},{"name":"Catálogo","description":"Categorías de tiendas y solicitudes"},{"name":"Administración","description":"Revisión de tiendas"},{"name":"Usuarios","description":"Perfil del usuario actual"},{"name":"Clientes","description":"Direcciones de entrega del cliente"},{"name":"Eventos","description":"Notificaciones en tiempo real (SSE)"},{"name":"Autenticación","description":"Registro de clientes, inicio y cierre de sesión"},{"name":"Mensajería","description":"Contactar por WhatsApp"}],"paths":{"/api/v1/tiendas/me/perfil":{"put":{"tags":["Tiendas"],"summary":"Actualizar perfil y horario","description":"HU-009. Nombre, teléfono y una franja por día en hora de Colombia; los días que no se envían quedan cerrados.","operationId":"actualizarPerfil","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActualizarPerfilTiendaRequest"}}},"required":true},"responses":{"400":{"description":"Datos inválidos (GEN-001) u horario inválido (TIE-007)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MiTienda"}}}}}}},"/api/v1/tiendas/me/medios-pago":{"get":{"tags":["Tiendas"],"summary":"Ver mis medios de pago","operationId":"consultar","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediosPagoResponse"}}}}}},"put":{"tags":["Tiendas"],"summary":"Configurar medios de pago","description":"HU-012. Reemplaza la lista: el medio que no se envía queda desactivado.","operationId":"guardar","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfigurarMediosPagoRequest"}}},"required":true},"responses":{"400":{"description":"Ningún medio o uno desconocido (GEN-001, TIE-011)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MediosPagoResponse"}}}}}}},"/api/v1/tiendas/me/domicilio":{"get":{"tags":["Tiendas"],"summary":"Ver mi domicilio","operationId":"consultar_1","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Domicilio"}}}}}},"put":{"tags":["Tiendas"],"summary":"Configurar domicilio","description":"HU-010. Activa o apaga el domicilio, radio y tarifa fija.","operationId":"guardar_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfigurarDomicilioRequest"}}},"required":true},"responses":{"400":{"description":"Datos inválidos (GEN-001) o domicilio inválido (TIE-009)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Domicilio"}}}}}}},"/api/v1/clientes/me/direcciones/{direccionId}":{"put":{"tags":["Clientes"],"summary":"Editar una dirección","operationId":"editar","parameters":[{"name":"direccionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DireccionRequest"}}},"required":true},"responses":{"404":{"description":"No existe o es de otro cliente (CLI-003)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DatosDireccion"}}}}}},"delete":{"tags":["Clientes"],"summary":"Borrar una dirección","operationId":"borrar","parameters":[{"name":"direccionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Dirección borrada"},"404":{"description":"No existe o es de otro cliente (CLI-003)"}}}},"/api/v1/tiendas/registro":{"post":{"tags":["Tiendas"],"summary":"Registrar tienda","description":"HU-002. multipart/form-data con la parte \"datos\" (JSON, Content-Type application/json) y los archivos \"fotoLocal\" y \"rut\" (JPEG, PNG, WebP o PDF de máximo 5 MB). Crea la cuenta del dueño con rol TIENDA y deja la tienda PENDIENTE de revisión.","operationId":"registrar","requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"datos":{"$ref":"#/components/schemas/RegistrarTiendaRequest"},"fotoLocal":{"type":"string","format":"binary","description":"Foto del local"},"rut":{"type":"string","format":"binary","description":"RUT"}},"required":["datos"]}}}},"responses":{"201":{"description":"Tienda registrada y en revisión","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaRegistradaResponse"}}}},"400":{"description":"Datos inválidos (GEN-001, TIE-001), documento faltante (TIE-002) o archivo no permitido (TIE-003); reglas de la cuenta (IDE-002 a IDE-007)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaRegistradaResponse"}}}},"409":{"description":"El correo ya tiene una cuenta (IDE-001)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaRegistradaResponse"}}}},"413":{"description":"Un archivo pesa más de 5 MB (GEN-010)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaRegistradaResponse"}}}}}}},"/api/v1/solicitudes":{"post":{"tags":["Solicitudes"],"summary":"Publicar solicitud","description":"HU-016. Publica \"¿quién tiene X?\" para las tiendas cercanas. Máximo 10 por hora.","operationId":"publicar","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicarSolicitudRequest"}}},"required":true},"responses":{"201":{"description":"Solicitud ABIERTA con su fecha de vencimiento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SolicitudResponse"}}}},"400":{"description":"Falta un dato (GEN-001, SOL-002)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SolicitudResponse"}}}},"403":{"description":"Solo los clientes publican solicitudes (GEN-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SolicitudResponse"}}}},"429":{"description":"Superó las 10 solicitudes de la última hora (SOL-001); Retry-After dice cuándo reintentar","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SolicitudResponse"}}}}}}},"/api/v1/solicitudes/{solicitudId}/respuestas":{"get":{"tags":["Solicitudes"],"summary":"Ver y ordenar las respuestas de mi solicitud","description":"HU-020. Tarjetas SI y PARECIDO; las NO solo cuentan en respuestasRecibidas.","operationId":"listarRespuestas","parameters":[{"name":"solicitudId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"orden","in":"query","description":"precio (por defecto), distancia o total con domicilio","required":false,"schema":{"type":"string","default":"precio","enum":["precio","distancia","total"]}}],"responses":{"200":{"description":"Respuestas ordenadas","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RespuestasDeSolicitudResponse"}}}},"404":{"description":"No existe o es de otro cliente (SOL-003)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RespuestasDeSolicitudResponse"}}}}}},"post":{"tags":["Solicitudes"],"summary":"Responder una solicitud","description":"HU-019. SI con precio y unidades; PARECIDO además con la descripción; NO sin datos. Una sola vez por tienda y mientras la solicitud esté abierta.","operationId":"responder","parameters":[{"name":"solicitudId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResponderSolicitudRequest"}}},"required":true},"responses":{"201":{"description":"Respuesta registrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RespuestaDeTiendaResponse"}}}},"400":{"description":"Datos inválidos (GEN-001) o respuesta incompleta (SOL-006)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RespuestaDeTiendaResponse"}}}},"404":{"description":"La solicitud no existe o no llegó a esta tienda (SOL-003)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RespuestaDeTiendaResponse"}}}},"409":{"description":"Ya respondió (SOL-005) o la solicitud se cerró (SOL-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RespuestaDeTiendaResponse"}}}}}}},"/api/v1/ordenes":{"get":{"tags":["Órdenes"],"summary":"Ver mis órdenes","description":"HU-027. Primero las activas. Máximo 50.","operationId":"listar","responses":{"200":{"description":"Órdenes del usuario","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/OrdenResponse"}}}}}}},"post":{"tags":["Órdenes"],"summary":"Elegir una respuesta y crear la orden","description":"HU-024. Total = precio × unidades + domicilio. Una sola elección por solicitud.","operationId":"crear","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearOrdenRequest"}}},"required":true},"responses":{"201":{"description":"Orden CONFIRMADO con el desglose","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"400":{"description":"Datos inválidos (GEN-001) o falta la dirección (ORD-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"404":{"description":"Respuesta (SOL-007) o dirección (CLI-003) no encontrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"409":{"description":"La solicitud ya no está abierta (SOL-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"422":{"description":"Medio de pago no aceptado (ORD-003), respuesta NO (SOL-008) o fuera de cobertura (TIE-010)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}}}}},"/api/v1/ordenes/{ordenId}/recepcion":{"post":{"tags":["Órdenes"],"summary":"Confirmar que recibí mi pedido","description":"HU-028. Solo con la orden ENTREGADO; queda RESUELTA.","operationId":"confirmarRecepcion","parameters":[{"name":"ordenId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Orden RESUELTA","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"404":{"description":"No existe o es de otro cliente (ORD-001)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"409":{"description":"Todavía no está ENTREGADO (ORD-002)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}}}}},"/api/v1/clientes/me/direcciones":{"get":{"tags":["Clientes"],"summary":"Listar mis direcciones","operationId":"listar_1","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/DatosDireccion"}}}}}}},"post":{"tags":["Clientes"],"summary":"Guardar una dirección","description":"HU-007 (CP-CLI-007-01). Máximo 10 por cliente.","operationId":"crear_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DireccionRequest"}}},"required":true},"responses":{"201":{"description":"Dirección guardada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DatosDireccion"}}}},"400":{"description":"Falta un dato (GEN-001, CLI-001)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DatosDireccion"}}}},"422":{"description":"Ya tiene 10 direcciones (CLI-002)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DatosDireccion"}}}}}}},"/api/v1/auth/totp":{"post":{"tags":["Autenticación"],"summary":"Verificar el segundo factor","description":"HU-004. Con el token temporal del inicio de sesión y el código de 6 dígitos de la aplicación autenticadora, entrega la sesión del administrador.","operationId":"verificarSegundoFactor","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VerificarSegundoFactorRequest"}}},"required":true},"responses":{"200":{"description":"Sesión del administrador iniciada","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}},"401":{"description":"Código incorrecto (IDE-012) o verificación vencida (IDE-013)","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}}}}},"/api/v1/auth/registro":{"post":{"tags":["Autenticación"],"summary":"Registrar cliente","description":"HU-001. Crea una cuenta de cliente activa.","operationId":"registrar_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegistrarClienteRequest"}}},"required":true},"responses":{"201":{"description":"Cuenta creada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioRegistradoResponse"}}}},"400":{"description":"Datos inválidos (GEN-001) o frase débil (IDE-002, IDE-003, IDE-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioRegistradoResponse"}}}},"409":{"description":"El correo ya tiene una cuenta (IDE-001)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioRegistradoResponse"}}}}}}},"/api/v1/auth/refresco":{"post":{"tags":["Autenticación"],"summary":"Renovar la sesión","description":"HU-003. Usa la cookie de refresco, la cambia por una nueva y entrega otro token de acceso.","operationId":"refrescarSesion","parameters":[{"name":"qlt_refresco","in":"cookie","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Sesión renovada","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}},"401":{"description":"Sin cookie, o token vencido o revocado (IDE-010)","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}}}}},"/api/v1/auth/logout":{"post":{"tags":["Autenticación"],"summary":"Cerrar sesión","description":"HU-003. Revoca el token de refresco y borra la cookie.","operationId":"cerrarSesion","parameters":[{"name":"qlt_refresco","in":"cookie","required":false,"schema":{"type":"string"}}],"responses":{"204":{"description":"Sesión cerrada"}}}},"/api/v1/auth/login":{"post":{"tags":["Autenticación"],"summary":"Iniciar sesión","description":"HU-003. Devuelve el token de acceso de 15 minutos y deja el token de refresco en la cookie qlt_refresco. Para el administrador devuelve segundoFactorRequerido=true y un token temporal para POST /api/v1/auth/totp (HU-004).","operationId":"iniciarSesion","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IniciarSesionRequest"}}},"required":true},"responses":{"200":{"description":"Sesión iniciada o segundo factor pendiente","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}},"401":{"description":"Correo o frase incorrectos (IDE-008); administrador sin segundo factor (IDE-011)","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}},"403":{"description":"Cuenta suspendida (IDE-009)","content":{"*/*":{"schema":{"oneOf":[{"$ref":"#/components/schemas/SegundoFactorPendienteResponse"},{"$ref":"#/components/schemas/SesionResponse"}]}}}}}}},"/api/v1/admin/tiendas/{tiendaId}/rechazo":{"post":{"tags":["Administración"],"summary":"Rechazar tienda","description":"HU-036 (CP-ADM-036-02). La tienda queda RECHAZADA con el motivo.","operationId":"rechazar","parameters":[{"name":"tiendaId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RechazarTiendaRequest"}}},"required":true},"responses":{"400":{"description":"Falta el motivo (GEN-001, TIE-005)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaParaRevision"}}}},"409":{"description":"La tienda no está PENDIENTE (TIE-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaParaRevision"}}}}}}},"/api/v1/admin/tiendas/{tiendaId}/aprobacion":{"post":{"tags":["Administración"],"summary":"Aprobar tienda","description":"HU-036 (CP-ADM-036-01). La tienda queda APROBADA.","operationId":"aprobar","parameters":[{"name":"tiendaId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"409":{"description":"La tienda no está PENDIENTE (TIE-004)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TiendaParaRevision"}}}}}}},"/api/v1/usuarios/me":{"get":{"tags":["Usuarios"],"summary":"Ver mi perfil","operationId":"consultar_2","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilUsuario"}}}}}},"patch":{"tags":["Usuarios"],"summary":"Editar mi nombre y teléfono","description":"HU-007 (CU-03 pasos 14 a 16).","operationId":"actualizar","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActualizarPerfilRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilUsuario"}}}}}}},"/api/v1/tiendas/me/apertura":{"patch":{"tags":["Tiendas"],"summary":"Abrir o cerrar la tienda","description":"HU-013. Abierta (y en su horario) recibe solicitudes nuevas; cerrada deja de recibirlas.","operationId":"cambiarApertura","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CambiarAperturaRequest"}}},"required":true},"responses":{"409":{"description":"La tienda aún no está aprobada (TIE-008)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MiTienda"}}}}}}},"/api/v1/ordenes/{ordenId}/estado":{"patch":{"tags":["Órdenes"],"summary":"Avanzar el estado de la orden","description":"HU-027. Solo el paso siguiente válido.","operationId":"cambiarEstado","parameters":[{"name":"ordenId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CambiarEstadoOrdenRequest"}}},"required":true},"responses":{"200":{"description":"Orden con el estado nuevo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"404":{"description":"No existe o no es de esta tienda (ORD-001)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"409":{"description":"Cambio de estado no permitido (ORD-002)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}}}}},"/api/v1/tiendas/me":{"get":{"tags":["Tiendas"],"summary":"Ver mi tienda","description":"Estado, motivo de rechazo si lo hay, perfil y horario.","operationId":"consultar_3","responses":{"404":{"description":"El usuario no tiene tienda (TIE-006)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MiTienda"}}}}}}},"/api/v1/tiendas/me/respuestas":{"get":{"tags":["Solicitudes"],"summary":"Ver mis respuestas","description":"HU-021. Respuestas SI y PARECIDO de las últimas 24 horas con su estado.","operationId":"listar_2","responses":{"200":{"description":"Respuestas de la tienda, la más reciente primero","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RespuestaDeTiendaResponse"}}}}}}}},"/api/v1/tiendas/me/domicilio/simulacion":{"get":{"tags":["Tiendas"],"summary":"Simular el costo del domicilio","description":"CU-17 pasos 7 a 10. Lo que pagaría un cliente con ese subtotal y a esa distancia.","operationId":"simular","parameters":[{"name":"subtotalEnPesos","in":"query","required":true,"schema":{"type":"integer","format":"int64","minimum":0}},{"name":"distanciaEnMetros","in":"query","required":true,"schema":{"type":"integer","format":"int32","minimum":0}}],"responses":{"422":{"description":"No hace domicilio o el cliente está fuera del radio (TIE-010)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SimulacionDomicilioResponse"}}}}}}},"/api/v1/solicitudes/{solicitudId}":{"get":{"tags":["Solicitudes"],"summary":"Ver mi solicitud","description":"HU-020 y HU-021. Estado, respuestas recibidas y la orden si ya eligió.","operationId":"obtener","parameters":[{"name":"solicitudId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"La solicitud","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SolicitudResponse"}}}},"404":{"description":"No existe o es de otro cliente (SOL-003)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SolicitudResponse"}}}}}}},"/api/v1/solicitudes/disponibles":{"get":{"tags":["Solicitudes"],"summary":"Ver solicitudes nuevas de mi tienda","description":"HU-018. ABIERTAS que llegaron a la tienda y que no ha respondido; urgentes primero. Sin datos del cliente; distancia redondeada a 100 m.","operationId":"listarDisponibles","responses":{"200":{"description":"Solicitudes nuevas (lista vacía si no hay)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SolicitudDisponibleResponse"}}}}},"403":{"description":"Solo las tiendas (GEN-004)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SolicitudDisponibleResponse"}}}}},"404":{"description":"El usuario no tiene tienda (TIE-006)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SolicitudDisponibleResponse"}}}}}}}},"/api/v1/ordenes/{ordenId}":{"get":{"tags":["Órdenes"],"summary":"Ver una orden","description":"HU-024 y HU-027. La tienda ve los datos del cliente solo mientras la orden está activa.","operationId":"obtener_1","parameters":[{"name":"ordenId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"La orden","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}},"404":{"description":"No existe o no es del usuario (ORD-001)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrdenResponse"}}}}}}},"/api/v1/ordenes/{ordenId}/whatsapp":{"get":{"tags":["Mensajería"],"summary":"Obtener el enlace de WhatsApp de la otra parte","description":"HU-032. Solo con la orden activa; el cliente recibe el número de la tienda y la tienda el del cliente.","operationId":"obtener_2","parameters":[{"name