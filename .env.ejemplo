# Copia este archivo como .env (que no se sube a Git) y pon tus valores.
# Nunca subas un .env con valores reales al repositorio (RNF-030).

# Base de datos (compose.yaml y la aplicación)
QLT_DB_NOMBRE=quienlotiene
QLT_DB_USUARIO=quienlotiene
QLT_DB_CLAVE=cambia-esta-clave-por-una-larga
QLT_DB_PUERTO=5432
# Solo en prod; en dev la conexión la arma Spring Boot a partir de compose.yaml
QLT_DB_URL=jdbc:postgresql://localhost:5432/quienlotiene

# Firma de los JWT con RS256 (D-15). Llaves en formato PEM en una sola línea, sin comillas.
# En dev se pueden dejar vacías: la app genera llaves temporales (las sesiones se pierden al reiniciar).
# Para generarlas:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-privada.pem
#   openssl pkey -in jwt-privada.pem -pubout -out jwt-publica.pem
# y copia cada archivo en una sola línea (sin los saltos de línea o con \n en su lugar).
QLT_JWT_LLAVE_PRIVADA=
QLT_JWT_LLAVE_PUBLICA=
QLT_JWT_KID=llave-1

# Orígenes del frontend que pueden llamar a la API (CORS), separados por comas
QLT_CORS_ORIGENES=http://localhost:5173
