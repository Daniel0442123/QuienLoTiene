# Respaldo diario de Quién lo tiene. Se instala con:
#   sudo cp /opt/quienlotiene/respaldo/quienlotiene-respaldo.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now quienlotiene-respaldo.timer
[Unit]
Description=Respaldo de Quién lo tiene (pg_dump y documentos con restic)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/quienlotiene/respaldo/respaldo.sh
Nice=10
IOSchedulingClass=idle
