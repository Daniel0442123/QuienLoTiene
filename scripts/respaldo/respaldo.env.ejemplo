# Copia este archivo como /opt/quienlotiene/respaldo.env (chmod 600, dueño root) y pon tus valores.
# Nunca subas el respaldo.env con valores reales al repositorio (RNF-030).

# Repositorio de restic en Backblaze B2 por su API compatible con S3.
# El endpoint sale de la página del bucket en B2 ("Endpoint"), por ejemplo s3.us-east-005.backblazeb2.com
RESTIC_REPOSITORY=s3:https://s3.us-east-005.backblazeb2.com/nombre-del-bucket/quienlotiene
# Llave de aplicación de B2 con acceso solo a ese bucket (keyID y applicationKey)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Contraseña con la que restic cifra los respaldos: openssl rand -base64 33
# Guárdala en el gestor de contraseñas: sin ella los respaldos no se pueden leer.
RESTIC_PASSWORD=

# Opcional: URL de un chequeo de Healthchecks.io para recibir un aviso si el respaldo falla o no corre
QLT_PING_RESPALDO=
